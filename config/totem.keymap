#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define CODE 1
#define NAV  2
#define MOD  3
#define ADJ  4

/ {
    behaviors {
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <125>;
            quick-tap-ms = <100>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <125>;
            quick-tap-ms = <100>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        td_bs_pipe: backslash_pipe {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
            layers = <0>;
        };

        apostrophe {
            timeout-ms = <50>;
            key-positions = <28 29>;
            bindings = <&kp APOS>;
            layers = <0>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <27 28>;
        };

        switch-lang {
            bindings = <&kp LG(SPACE)>;
            key-positions = <22 23>;
        };

        caps {
            bindings = <&kp CAPS>;
            key-positions = <23 24>;
        };

        left-bracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <6 7>;
        };

        right-bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <7 8>;
        };
    };

    macros {
        mac_lock: mac_lock_screen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI &kp LCTRL>,
                <&macro_pause_for_release>,
                <&macro_tap>,
                <&kp Q>,
                <&macro_release>,
                <&kp LGUI &kp LCTRL>;
        };

        win_lock: win_lock_screen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI>,
                <&macro_tap>,
                <&kp L>,
                <&macro_release>,
                <&kp LGUI>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
       &kp CAPSLOCK    &kp W           &kp E        &kp R             &kp T          &kp Y        &kp U        &kp I            &kp O              &kp BACKSPACE
       &kp A           &kp S           &kp D        &kp F             &kp G          &kp H        &kp J        &kp K            &kp L              &kp SEMI
&kp Q  &mt LEFT_GUI Z  &mt LEFT_ALT X  &mt LCTRL C  &mt LEFT_SHIFT V  &mt LCTRL B    &kp N        &mt RSHFT M  &mt RCTRL COMMA  &mt RIGHT_ALT DOT  &mt LEFT_GUI FSLH  &lt 8 P
                                       &lt 4 ESC    &lt 2 SPACE       &lt 3 TAB      &lt 6 ENTER  &lt 5 SPACE  &lt 7 DEL
            >;
        };

        colemak-dh {
            bindings = <
       &kp CAPSLOCK    &kp W           &kp F        &kp P             &kp B          &kp J        &kp L              &kp U            &kp Y                 &kp BACKSPACE
       &kp A           &kp R           &kp S        &kp T             &kp G          &kp M        &kp N              &kp E            &kp I                 &kp O
&kp Q  &mt LEFT_GUI Z  &mt LEFT_ALT X  &mt LCTRL C  &mt LEFT_SHIFT D  &mt LCTRL V    &kp K        &mt RIGHT_SHIFT H  &mt RCTRL COMMA  &mt RIGHT_ALT PERIOD  &mt RIGHT_GUI SLASH  &lt 8 SEMI
                                       &lt 4 ESC    &lt 2 SPACE       &lt 3 TAB      &lt 6 ENTER  &lt 5 SPACE        &lt 7 DEL
            >;
        };

        nav_layer {
            bindings = <
        &kp NUMBER_1         &kp NUMBER_2        &kp NUMBER_3      &kp NUMBER_4            &kp NUMBER_5       &kp LEFT_PARENTHESIS  &kp LEFT_BRACKET  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp BACKSPACE
        &kp NUMBER_6         &kp NUMBER_7        &kp NUMBER_8      &kp NUMBER_9            &kp NUMBER_0       &kp LEFT_ARROW        &kp DOWN_ARROW    &kp UP_ARROW           &kp RIGHT          &kp SQT
&trans  &mt LEFT_GUI K_UNDO  &mt LEFT_ALT K_CUT  &mt LCTRL K_COPY  &mt LEFT_SHIFT K_PASTE  &mt LCTRL MINUS    &kp HOME              &kp MINUS         &kp EQUAL              &kp END            &kp CAPSLOCK   &kp INS
                                                 &trans            &trans                  &trans             &kp ENTER             &kp BACKSPACE     &kp DELETE
            >;
        };

        mod_layer {
            bindings = <
        &kp F1            &kp F2            &kp F3           &kp F4                &kp F5     &trans     &trans         &trans      &trans  &trans
        &kp F6            &kp F7            &kp F8           &kp F9                &kp F10    &trans     &trans         &trans      &trans  &trans
&trans  &mt LEFT_GUI F11  &mt LEFT_ALT F12  &mt LCTRL MINUS  &mt LEFT_SHIFT EQUAL  &trans     &trans     &trans         &trans      &trans  &trans  &trans
                                            &trans           &trans                &trans     &kp ENTER  &kp BACKSPACE  &kp DELETE
            >;
        };

        adj_layer {
            bindings = <
        &trans        &trans        &trans     &trans          &trans    &kp C_MUTE    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &trans        &bt BT_CLR_ALL
        &trans        &trans        &trans     &trans          &trans    &kp C_PREV    &kp C_PLAY         &kp C_PAUSE      &kp C_NEXT    &trans
&trans  &kp LEFT_GUI  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &trans    &bt BT_SEL 0  &bt BT_SEL 1       &bt BT_SEL 2     &bt BT_SEL 3  &bt BT_CLR      &trans
                                    &trans     &trans          &trans    &trans        &trans             &trans
            >;
        };

        layer_numbers {
            bindings = <
        &kp TILDE      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans          &trans  &trans           &trans     &trans         &trans
        &kp EQUAL      &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_0    &trans  &trans           &trans     &trans         &trans
&trans  &kp BACKSLASH  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp DOT         &trans  &kp RIGHT_SHIFT  &kp RCTRL  &kp RIGHT_ALT  &kp RIGHT_GUI  &trans
                                     &trans        &kp SPACE     &kp MINUS       &trans  &trans           &trans
            >;
        };

        layer_symbols {
            bindings = <
        &kp TILDE  &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS  &trans                   &trans  &trans     &trans     &trans         &trans
        &kp PLUS   &kp DOLLAR       &kp PERCENT   &kp CARET             &kp RIGHT_PARENTHESIS    &trans  &trans     &trans     &trans         &trans
&trans  &kp PIPE   &kp EXCLAMATION  &kp AT_SIGN   &kp HASH              &kp COMMA                &trans  &kp RSHFT  &kp RCTRL  &kp RIGHT_ALT  &kp RIGHT_GUI  &trans
                                    &trans        &kp SPACE             &kp UNDER                &trans  &trans     &trans
            >;
        };

        layer_f {
            bindings = <
                &kp F12  &kp F7  &kp F8  &kp F9  &kp PRINTSCREEN    &trans  &trans           &trans     &trans         &trans
                &kp F11  &kp F4  &kp F5  &kp F6  &kp SCROLLLOCK     &trans  &trans           &trans     &trans         &trans
&studio_unlock  &kp F10  &kp F1  &kp F2  &kp F3  &kp PAUSE_BREAK    &trans  &kp RIGHT_SHIFT  &kp RCTRL  &kp RIGHT_ALT  &kp RIGHT_GUI  &trans
                                 &trans  &trans  &trans             &trans  &trans           &trans
            >;
        };

        layer_management {
            bindings = <
        &trans  &tog 0  &tog 1  &trans  &trans    &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};

&sk {
    release-after-ms = <2000>;
    quick-release;
};

