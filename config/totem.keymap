#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define CODE 1
#define NAV  2
#define MOD  3
#define ADJ  4

/ {
    behaviors {
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <110>;
            quick-tap-ms = <100>;
            require-prior-idle-ms = <140>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <110>;
            quick-tap-ms = <100>;
            require-prior-idle-ms = <140>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        td_bs_pipe: backslash_pipe {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        sticky_tap_kp_hold: sticky_tap_kp_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "STICKY_TAP_KP_HOLD";
            bindings = <&kp>, <&sk>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
        };

        sticky_tap_layer_hold: sticky_tap_layer_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "STICKY_TAP_LAYER_HOLD";
            bindings = <&mo>, <&sk>;

            #binding-cells = <2>;
            tapping-term-ms = <120>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
            layers = <0 1>;
        };

        apostrophe {
            timeout-ms = <50>;
            key-positions = <28 29>;
            bindings = <&kp APOS>;
            layers = <0 1>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <27 28>;
            timeout-ms = <50>;
            layers = <0 1>;
        };

        caps {
            bindings = <&kp CAPSLOCK>;
            key-positions = <22 23>;
            timeout-ms = <50>;
            layers = <0 1>;
        };

        /* caps { */
        /*     bindings = <&kp CAPS>; */
        /*     key-positions = <23 24>; */
        /* }; */

        left-bracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <6 7>;
            timeout-ms = <50>;
            layers = <0 1>;
        };

        right-bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <7 8>;
            timeout-ms = <50>;
            layers = <0 1>;
        };
    };

    macros {
        mac_lock: mac_lock_screen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI &kp LCTRL>,
                <&macro_pause_for_release>,
                <&macro_tap>,
                <&kp Q>,
                <&macro_release>,
                <&kp LGUI &kp LCTRL>;
        };

        win_lock: win_lock_screen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI>,
                <&macro_tap>,
                <&kp L>,
                <&macro_release>,
                <&kp LGUI>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
               &kp Q  &kp W  &kp E      &kp R        &kp T                                  &kp Y                                 &kp U        &kp I      &kp O    &kp P
               &kp A  &kp S  &kp D      &kp F        &kp G                                  &kp H                                 &kp J        &kp K      &kp L    &kp SEMI
&kp LG(SPACE)  &kp Z  &kp X  &kp C      &kp V        &kp B                                  &kp N                                 &kp M        &kp COMMA  &kp DOT  &kp FSLH  &lt 8 BACKSPACE
                             &lt 4 ESC  &lt 2 SPACE  &sticky_tap_layer_hold 3 LEFT_SHIFT    &sticky_tap_layer_hold 6 RIGHT_SHIFT  &lt 5 SPACE  &lt 7 DEL
            >;
        };

        colemak-dh {
            bindings = <
               &kp Q  &kp W  &kp F      &kp P        &kp B                                  &kp J                                 &kp L        &kp U      &kp Y       &kp SEMI
               &kp A  &kp R  &kp S      &kp T        &kp G                                  &kp M                                 &kp N        &kp E      &kp I       &kp O
&kp LG(SPACE)  &kp Z  &kp X  &kp C      &kp D        &kp V                                  &kp K                                 &kp H        &kp COMMA  &kp PERIOD  &kp SLASH  &lt 8 BACKSPACE
                             &lt 4 ESC  &lt 2 SPACE  &sticky_tap_layer_hold 3 LEFT_SHIFT    &sticky_tap_layer_hold 6 RIGHT_SHIFT  &lt 5 SPACE  &lt 7 DEL
            >;
        };

        nav_layer {
            bindings = <
        &kp ESC       &kp NUMBER_1  &kp NUMBER_2      &kp NUMBER_3    &kp NUMBER_4    &kp HOME        &kp PAGE_DOWN     &kp PAGE_UP            &kp END            &kp BACKSPACE
        &sk LEFT_GUI  &sk LEFT_ALT  &sk LEFT_CONTROL  &sk LEFT_SHIFT  &kp NUMBER_0    &kp LEFT_ARROW  &kp DOWN_ARROW    &kp UP_ARROW           &kp RIGHT          &kp ENTER
&trans  &kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_7      &kp NUMBER_8    &kp NUMBER_9    &kp LPAR        &kp LEFT_BRACKET  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp CAPSLOCK   &kp INS
                                    &trans            &trans          &trans          &kp TAB         &kp SPACE         &kp DELETE
            >;
        };

        mod_layer {
            bindings = <
        &kp F1        &kp F2        &kp F3            &kp F4          &kp F5     &trans     &trans     &trans      &trans  &trans
        &sk LEFT_GUI  &sk LEFT_ALT  &sk LEFT_CONTROL  &sk LEFT_SHIFT  &kp F10    &trans     &trans     &trans      &trans  &trans
&trans  &kp F6        &kp F7        &kp F8            &kp F9          &trans     &trans     &trans     &trans      &trans  &trans  &trans
                                    &trans            &trans          &trans     &kp ENTER  &kp SPACE  &kp DELETE
            >;
        };

        adj_layer {
            bindings = <
        &trans        &trans        &trans            &trans          &trans    &kp C_MUTE    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &trans        &bt BT_CLR_ALL
        &sk LEFT_GUI  &sk LEFT_ALT  &sk LEFT_CONTROL  &sk LEFT_SHIFT  &trans    &kp C_PREV    &kp C_PLAY         &kp C_PAUSE      &kp C_NEXT    &trans
&trans  &trans        &trans        &trans            &trans          &trans    &bt BT_SEL 0  &bt BT_SEL 1       &bt BT_SEL 2     &bt BT_SEL 3  &bt BT_CLR      &trans
                                    &trans            &trans          &trans    &trans        &trans             &trans
            >;
        };

        layer_numbers {
            bindings = <
        &kp TILDE  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans           &kp RS(NUMBER_5)  &trans           &trans             &trans         &trans
        &kp EQUAL  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp DOT          &kp RS(NUMBER_6)  &sk RIGHT_SHIFT  &sk RIGHT_CONTROL  &sk RIGHT_ALT  &sk RIGHT_GUI
&trans  &kp MINUS  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp BACKSLASH    &trans            &trans           &trans             &trans         &trans         &trans
                                 &trans        &kp SPACE     &kp NUMBER_0     &trans            &trans           &trans
            >;
        };

        layer_symbols {
            bindings = <
        &kp TILDE  &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS  &trans                   &trans  &trans           &trans             &trans         &trans
        &kp PLUS   &kp DOLLAR       &kp PERCENT   &kp CARET             &kp RIGHT_PARENTHESIS    &trans  &sk RIGHT_SHIFT  &sk RIGHT_CONTROL  &sk RIGHT_ALT  &sk RIGHT_GUI
&trans  &kp PIPE   &kp EXCLAMATION  &kp AT_SIGN   &kp HASH              &kp COMMA                &trans  &trans           &trans             &trans         &trans         &trans
                                    &trans        &kp SPACE             &kp UNDER                &trans  &trans           &trans
            >;
        };

        layer_f {
            bindings = <
                &kp F12  &kp F7  &kp F8  &kp F9  &kp PRINTSCREEN    &trans  &trans           &trans             &trans         &trans
                &kp F11  &kp F4  &kp F5  &kp F6  &kp SCROLLLOCK     &trans  &sk RIGHT_SHIFT  &sk RIGHT_CONTROL  &sk RIGHT_ALT  &sk RIGHT_GUI
&studio_unlock  &kp F10  &kp F1  &kp F2  &kp F3  &kp PAUSE_BREAK    &trans  &trans           &trans             &trans         &trans         &trans
                                 &trans  &trans  &trans             &trans  &trans           &trans
            >;
        };

        layer_management {
            bindings = <
        &trans  &tog 0  &tog 1  &trans  &trans    &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};

&lt {
    tapping-term-ms = <120>;
    flavor = "hold-preferred";
};

&sk {
    release-after-ms = <2000>;
    quick-release;
};

