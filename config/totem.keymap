#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define CODE 1
#define NAV  2
#define MOD  3
#define ADJ  4

/ {
    behaviors {
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <125>;
            quick-tap-ms = <100>;
            require-prior-idle-ms = <150>;

            /* flavor = "balanced"; */

            flavor = "hold-while-undecided";
            bindings = <&kp>, <&kp>;
        };
        
        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <125>;
            quick-tap-ms = <100>;
            require-prior-idle-ms = <150>;

            /* flavor = "balanced"; */

            flavor = "hold-while-undecided";
            bindings = <&kp>, <&kp>;
        };
        
        td_bs_pipe: backslash_pipe {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";
        
        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
            layers = <0>; 
        };
        
        combo_dictation {
            timeout-ms = <50>;
            key-positions = <26 27>;
            bindings = <&kp LA(SPACE)>;
            slow-release;
            layers = <0>; 
        };
        
        combo_enye {
            timeout-ms = <50>;
            key-positions = <8 9>;
            bindings = <&kp RA(N)>;
            layers = <0>; 
        };
    };

    macros {
        mac_lock: mac_lock_screen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI &kp LCTRL>
                     , <&macro_pause_for_release>
                     , <&macro_tap &kp Q>
                     , <&macro_release &kp LGUI &kp LCTRL>;
        };
        
        win_lock: win_lock_screen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI>
                     , <&macro_tap &kp L>
                     , <&macro_release &kp LGUI>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

    base {
        bindings = <
          &kp Q        &kp W        &kp E         &kp R         &kp T        &kp Y        &kp U         &kp I         &kp O        &kp P
          &hml LGUI A  &hml LALT S  &hml LCTRL D  &hml LSHFT F  &kp G        &kp H        &hmr RSHFT J  &hmr RCTRL K  &hmr RALT L  &hmr RGUI SEMI
&kp LBKT  &kp Z        &kp X        &kp C         &kp V         &kp B        &kp N        &kp M         &kp COMMA     &kp DOT      &kp FSLH        &kp RBKT
                                    &lt 4 ESC     &lt 2 SPACE   &lt 3 TAB    &lt 6 ENTER  &lt 5 SPACE   &lt 7 DEL
        >;
    };


    colemak-dh {
        bindings = <
                &kp Q            &kp W        &kp F                &kp P              &kp B        &kp J        &kp L               &kp U                 &kp Y        &kp SEMI
                &hml LEFT_GUI A  &hml LALT R  &hml LEFT_CONTROL S  &hml LEFT_SHIFT T  &kp G        &kp M        &hmr RIGHT_SHIFT N  &hmr RIGHT_CONTROL E  &hmr RALT I  &hmr RIGHT_GUI O
&kp LEFT_BRACE  &kp Z            &kp X        &kp C                &kp D              &kp V        &kp K        &kp H               &kp COMMA             &kp PERIOD   &kp SLASH         &kp RIGHT_BRACE
                                              &lt 4 ESC            &lt 2 SPACE        &lt 3 TAB    &lt 6 ENTER  &lt 5 SPACE         &lt 7 DEL
        >;
    };

        nav_layer {
            bindings = <
        &kp NUMBER_1            &kp NUMBER_2            &kp NUMBER_3                &kp NUMBER_4              &kp NUMBER_5    &kp LEFT_PARENTHESIS  &kp LEFT_BRACKET  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp BACKSPACE
        &hml LEFT_GUI NUMBER_6  &hml LEFT_ALT NUMBER_7  &hml LEFT_CONTROL NUMBER_8  &hml LEFT_SHIFT NUMBER_9  &kp NUMBER_0    &kp LEFT_ARROW        &kp DOWN_ARROW    &kp UP_ARROW           &kp RIGHT          &kp SQT
&trans  &kp MINUS               &kp EQUAL               &trans                      &trans                    &trans          &kp HOME              &kp MINUS         &kp EQUAL              &kp END            &kp CAPSLOCK   &kp INS
                                                        &trans                      &trans                    &trans          &kp ENTER             &kp SPACE         &kp DELETE
            >;
        };

        mod_layer {
            bindings = <
        &kp F1            &kp F2        &kp F3                &kp F4              &kp F5     &trans          &trans      &trans           &trans      &trans
        &hml LEFT_GUI F6  &hml LALT F7  &hml LEFT_CONTROL F8  &hml LEFT_SHIFT F9  &kp F10    &kp C_PREVIOUS  &kp C_PLAY  &kp C_PAUSE      &kp C_NEXT  &trans
&trans  &kp F11           &kp F12       &trans                &trans              &trans     &kp C_VOLUME_DOWN    &kp C_MUTE  &kp C_VOLUME_UP  &trans      &trans  &trans
                                        &trans                &trans              &trans     &kp ENTER       &kp SPACE   &kp DELETE
            >;
        };

        adj_layer {
            bindings = <
        &trans        &trans        &trans            &trans          &trans    &kp C_MUTE    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &trans        &bt BT_CLR_ALL
        &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &trans    &kp C_PREV    &kp C_PLAY         &kp C_PAUSE      &kp C_NEXT    &trans
&trans  &trans        &trans        &trans            &trans          &trans    &bt BT_SEL 0  &bt BT_SEL 1       &bt BT_SEL 2     &bt BT_SEL 3  &bt BT_CLR      &trans
                                    &trans            &trans          &trans    &trans        &trans             &trans
            >;
        };

        layer_5 {
            bindings = <
        &trans        &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp BACKSLASH    &trans  &trans           &trans             &trans         &trans
        &kp NUMBER_0  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp EQUAL        &trans  &kp RIGHT_SHIFT  &kp RIGHT_CONTROL  &kp RIGHT_ALT  &kp RIGHT_GUI
&trans  &kp TILDE     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp MINUS        &trans  &trans           &trans             &trans         &trans         &trans
                                    &kp PERIOD    &kp SPACE     &kp TAB          &trans  &trans           &trans
            >;
        };

        layer_6 {
            bindings = <
        &studio_unlock  &kp F7  &kp F8  &kp F9  &kp F12    &trans  &trans           &trans             &trans         &trans
        &trans          &kp F4  &kp F5  &kp F6  &kp F11    &trans  &kp RIGHT_SHIFT  &kp RIGHT_CONTROL  &kp RIGHT_ALT  &kp RIGHT_GUI
&trans  &trans          &kp F1  &kp F2  &kp F3  &kp F10    &trans  &trans           &trans             &trans         &trans         &trans
                                &trans  &trans  &trans     &trans  &trans           &trans
            >;
        };

        layer_7 {
            bindings = <
        &studio_unlock  &kp F7  &kp F8  &kp F9  &kp F12    &trans        &trans        &trans        &trans        &bt BT_CLR_ALL
        &trans          &kp F4  &kp F5  &kp F6  &kp F11    &trans        &trans        &trans        &trans        &trans
&trans  &trans          &kp F1  &kp F2  &kp F3  &kp F10    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR      &trans
                                &trans  &trans  &trans     &trans        &trans        &trans
            >;
        };
        extra8  { status = "reserved"; display-name = "Extra 8"; };
        extra9  { status = "reserved"; display-name = "Extra 9"; };
        extra10 { status = "reserved"; display-name = "Extra 10"; };
    };
};

&sk {
    release-after-ms = <2000>;
    quick-release;
};
