#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define CODE 1
#define NAV  2
#define MOD  3
#define ADJ  4

/ {
    behaviors {
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <110>;
            quick-tap-ms = <100>;
            require-prior-idle-ms = <140>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <110>;
            quick-tap-ms = <100>;
            require-prior-idle-ms = <140>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        td_bs_pipe: backslash_pipe {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
            layers = <0 1>;
        };

        apostrophe {
            timeout-ms = <50>;
            key-positions = <28 29>;
            bindings = <&kp APOS>;
            layers = <0 1>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <27 28>;
            timeout-ms = <50>;
            layers = <0 1>;
        };

        switch-lang {
            bindings = <&kp LG(SPACE)>;
            key-positions = <22 23>;
            timeout-ms = <50>;
            layers = <0 1>;
        };

        /* caps { */
        /*     bindings = <&kp CAPS>; */
        /*     key-positions = <23 24>; */
        /* }; */

        left-bracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <6 7>;
            timeout-ms = <50>;
            layers = <0 1>;
        };

        right-bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <7 8>;
            timeout-ms = <50>;
            layers = <0 1>;
        };
    };

    macros {
        mac_lock: mac_lock_screen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI &kp LCTRL>,
                <&macro_pause_for_release>,
                <&macro_tap>,
                <&kp Q>,
                <&macro_release>,
                <&kp LGUI &kp LCTRL>;
        };

        win_lock: win_lock_screen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI>,
                <&macro_tap>,
                <&kp L>,
                <&macro_release>,
                <&kp LGUI>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
          &kp Q            &kp W            &kp E         &kp R          &kp T        &kp Y        &kp U          &kp I         &kp O             &kp P
          &hml LEFT_GUI A  &hml LEFT_ALT S  &hml LCTRL D  &hml LSHIFT F  &kp G        &kp H        &hmr RSHIFT J  &hmr RCTRL K  &hmr RIGHT_ALT L  &hmr RIGHT_GUI SEMI
&kp CAPS  &kp Z            &kp X            &kp C         &kp V          &kp B        &kp N        &kp M          &kp COMMA     &kp DOT           &kp FSLH             &lt 8 BACKSPACE
                                            &lt 4 ESC     &lt 2 SPACE    &lt 3 TAB    &lt 6 ENTER  &lt 5 SPACE    &lt 7 DEL
            >;
        };

        colemak-dh {
            bindings = <
          &kp Q            &kp W            &kp F         &kp P         &kp B        &kp J        &kp L               &kp U         &kp Y             &kp SEMI
          &hml LEFT_GUI A  &hml LEFT_ALT R  &hml LCTRL S  &hml LSHFT T  &kp G        &kp M        &hmr RIGHT_SHIFT N  &hmr RCTRL E  &hmr RIGHT_ALT I  &hmr RIGHT_GUI O
&kp CAPS  &kp Z            &kp X            &kp C         &kp D         &kp V        &kp K        &kp H               &kp COMMA     &kp PERIOD        &kp SLASH         &lt 8 BACKSPACE
                                            &lt 4 ESC     &lt 2 SPACE   &lt 3 TAB    &lt 6 ENTER  &lt 5 SPACE         &lt 7 DEL
            >;
        };

        nav_layer {
            bindings = <
        &kp NUMBER_1            &kp NUMBER_2            &kp NUMBER_3         &kp NUMBER_4              &kp NUMBER_5    &kp LEFT_PARENTHESIS  &kp LEFT_BRACKET  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp BACKSPACE
        &hml LEFT_GUI NUMBER_6  &hml LEFT_ALT NUMBER_7  &hml LCTRL NUMBER_8  &hml LEFT_SHIFT NUMBER_9  &kp NUMBER_0    &kp LEFT_ARROW        &kp DOWN_ARROW    &kp UP_ARROW           &kp RIGHT          &kp SQT
&trans  &kp K_UNDO              &kp K_CUT               &kp K_COPY           &kp K_PASTE               &trans          &kp HOME              &kp MINUS         &kp EQUAL              &kp END            &kp CAPSLOCK   &kp INS
                                                        &trans               &trans                    &trans          &kp ENTER             &kp SPACE         &kp DELETE
            >;
        };

        mod_layer {
            bindings = <
        &kp F1            &kp F2            &kp F3         &kp F4          &kp F5     &trans     &trans     &trans      &trans  &trans
        &hml LEFT_GUI F6  &hml LEFT_ALT F7  &hml LCTRL F8  &hml LSHIFT F9  &kp F10    &trans     &trans     &trans      &trans  &trans
&trans  &kp F11           &kp F12           &trans         &trans          &trans     &trans     &trans     &trans      &trans  &trans  &trans
                                            &trans         &trans          &trans     &kp ENTER  &kp SPACE  &kp DELETE
            >;
        };

        adj_layer {
            bindings = <
        &trans        &trans        &trans     &trans          &trans    &kp C_MUTE    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &trans        &bt BT_CLR_ALL
        &kp LEFT_GUI  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &trans    &kp C_PREV    &kp C_PLAY         &kp C_PAUSE      &kp C_NEXT    &trans
&trans  &trans        &trans        &trans     &trans          &trans    &bt BT_SEL 0  &bt BT_SEL 1       &bt BT_SEL 2     &bt BT_SEL 3  &bt BT_CLR      &trans
                                    &trans     &trans          &trans    &trans        &trans             &trans
            >;
        };

        layer_numbers {
            bindings = <
        &kp TILDE  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans           &trans  &trans           &trans     &trans         &trans
        &kp EQUAL  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_0     &trans  &kp RIGHT_SHIFT  &kp RCTRL  &kp RIGHT_ALT  &kp RIGHT_GUI
&trans  &kp MINUS  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp BACKSLASH    &trans  &trans           &trans     &trans         &trans         &trans
                                 &trans        &kp SPACE     &kp DOT          &trans  &trans           &trans
            >;
        };

        layer_symbols {
            bindings = <
        &kp TILDE  &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS  &trans                   &trans  &trans           &trans     &trans         &trans
        &kp PLUS   &kp DOLLAR       &kp PERCENT   &kp CARET             &kp RIGHT_PARENTHESIS    &trans  &kp RIGHT_SHIFT  &kp RCTRL  &kp RIGHT_ALT  &kp RIGHT_GUI
&trans  &kp PIPE   &kp EXCLAMATION  &kp AT_SIGN   &kp HASH              &kp COMMA                &trans  &trans           &trans     &trans         &trans         &trans
                                    &trans        &kp SPACE             &kp UNDER                &trans  &trans           &trans
            >;
        };

        layer_f {
            bindings = <
                &kp F12  &kp F7  &kp F8  &kp F9  &kp PRINTSCREEN    &trans  &trans      &trans     &trans         &trans
                &kp F11  &kp F4  &kp F5  &kp F6  &kp SCROLLLOCK     &trans  &kp RSHIFT  &kp RCTRL  &kp RIGHT_ALT  &kp RIGHT_GUI
&studio_unlock  &kp F10  &kp F1  &kp F2  &kp F3  &kp PAUSE_BREAK    &trans  &trans      &trans     &trans         &trans         &trans
                                 &trans  &trans  &trans             &trans  &trans      &trans
            >;
        };

        layer_management {
            bindings = <
        &trans  &tog 0  &tog 1  &trans  &trans    &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};

&lt {
    tapping-term-ms = <120>;
    flavor = "hold-preferred";
};

&sk {
    release-after-ms = <2000>;
    quick-release;
};

